{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/data-foundation?cadence=daily",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/data-foundation?cadence=weekly",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/data-foundation?cadence=monthly",
      "schedule": "0 6 1 * *"
    }
  ]
}
